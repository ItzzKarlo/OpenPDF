{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [{
      "title": "OpenPDF",
      "width": 1440,
      "height": 920,
      "minWidth": 900,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 17, "y": 22 },
      "dragDropEnabled": true
    }]
  },
  "bundle": {
    "targets": ["dmg"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
